def choice_doctor(invalid_choice, trust, freddy_name, doctor, visitors):
  player_input = int(input("\nJuniper needs a place to stay... could you give her a room? Select 1 for yes, 2 for no. "))

  invalid_choice = True

  while invalid_choice == True:
      match player_input:
        case 1:
          print("\nYou've decided to accept this visitor.")
          time.sleep(1)
          TypeText("\n'You can stay, if you'd like, at our place. The house is pretty big and, well, its been kinda empty so-'" "\n'Yes, YES! OF COURSE I CAN STAY. I'll help you if you ever get sick, you'd be in very good hands!'")
          time.sleep(2)
          TypeText("\nJuniper grabs the suitcases that was left previously ignored behind her and storms into the house.\n" f"{freddy_name} appears behind you and helps the new resident with her luggage.\n")
          time.sleep(2)
          TypeText("What have you done...\n")
          print("\n+1 Trust")
          trust = trust + 1
          print (f"Trust = {trust}")
          doctor = doctor + 1 
          visitors = visitors + 1 
          invalid_choice = False
          break

        case 2:
          print("You've decided to reject this visitor.")
          time.sleep(1)
          TypeText("\n>'Juniper.' Her face lights up which makes the next thing you're about to say much harder.\n" ">'We don't have any space for a doctor, here. I'm sorry, I wish I could help...'\n")
          time.sleep(2)
          TypeText("You both stand there in silence. You can't help but look for her reaction.\n" "It would be normal to try to negotiation or maybe even insult you for being so heartless.\n")
          time.sleep(2)
          TypeText("But she doesn't say anything. Juniper just kinda looks at you with a blank stare and nods her head.\n" "She nods her head and turns away from the door, picking up the suitcases as she exits your compound.")
          time.sleep(2)
          TypeText("Shutting the door, you start to think over what you're going to do for the rest of the day; the plants could do with watering...\n")                 
          time.sleep(1)
          TypeText(f"\n{freddy_name} glares at you from the top of the stairs.\n" "I don't think they're too happy at you turing down a peaceful looking visitor.")
          time.sleep(2)
          print("\n-1 Trust")
          trust = trust - 1
          print (f"Trust = {trust}")
          invalid_choice = False
          break

        case _:
          print("Invalid input. Please select 1 or 2.")
          player_input = int(input("\nJuniper needs a place to stay... could you give her a room? Select 1 for yes, 2 for no."))
          invalid_choice == True

