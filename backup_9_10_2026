def stat_checker(integrity, health, trust, supplies):

    #integrity
    if integrity== 1:
            TypeText("Integrity = 1\n" "The intergrity of your compound is VERY low, please find a way to increase it...")
    elif integrity== 2:
            TypeText("Integrity = 2\n" "The intergrity of your compound is low, you don't want it decrease any further.")
    elif integrity== 3:
            TypeText("Integrity = 3\n" "The intergrity of your compound is okay, you'll be fine for a hot minute.")
    elif integrity== 4: 
            TypeText("Integrity = 2\n" "The intergrity of your compound is pretty high, good job!")
    elif integrity== 5:
            TypeText("Integrity = 5\n" "The intergrity of your compound is really high! You'd be able to defend a massive hoard now!")

    time.sleep(2)

    #Health
    if health == 1:
            TypeText("\nHealth = 1\n" "It's a wonder how you're still alive... Your supplies have been decreased due to needing medicine.")
            supplies = supplies - 1
            TypeText ("\nSupplies now =", supplies)
    elif health == 2:
            TypeText ("\nHealth = 2\n" "You really don't want your household to get anymore ill, please find a way to get healthier.")
    elif health == 3:
            TypeText ("\nHealth = 3\n" "You're health is okay. You're not feeling too good or too bad at all.")
    elif health == 4:
            TypeText ("\nHealth = 4\n" "You're health is pretty good! You could surive an influenza or 2.")
    elif health == 5:
            TypeText("\nHealth = 5\n" "You're health is really good! You could run a 100m in 7s while you're this healthy!")

    time.sleep(2)

    #Trust
    if trust == 1:
            TypeText("\nTrust = 1\n" "Woah, how did you become so untrustworthy... You've noticed that supplies have been decreasing more than usual, a thief?")
            supplies = supplies -1
    elif trust == 2:
            TypeText("\nTrust = 2\n" "Your houshold has little faith in you and your leadership. Find a way to settle their worries.")
    elif trust == 3:
            TypeText("\nTrust = 3\n" "Your household has trust in you and you have trust in them.")
    elif trust == 4:
            TypeText("\nTrust = 4\n" "Your household has quite a bit of trust in you. Good job, try to keep it that way!")
    elif trust == 5:
            TypeText("\nTrust = 5\n" "Woah, your leadership skills are amazing! The people around you would jump of a cliff for you!")

    time.sleep(2)

    #Supplies
    if supplies == 1:
            TypeText ("\nSupplies = 1\n" "Your household is starving... Your health has decreased.")
            health = health - 1
            TypeText ("\nHealth now =", health)
    elif supplies == 2:
            TypeText ("\nSupplies = 2\n" "Your supplies are pretty low. If it gets any lower your family could starve..")
    elif supplies == 3:
            TypeText ("\nSupplies = 3\n" "Your supplies are okay, try to increase them soon.")
    elif supplies == 4:
            TypeText("\nSupplies = 4\n" "Your supplies are pretty good, let's keep it that way!")
    elif supplies == 5: 
            TypeText ("\nSupplies = 5\n" "Woah, your supply level is REALLY good. Seriously, you've got so much there isn't anymore space to store stuff in the house...")

