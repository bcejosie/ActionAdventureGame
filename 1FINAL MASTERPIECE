            TypeText("\nTrust = 4\n" "Your household has quite a bit of trust in you. Good job, try to keep it that way!")
    elif trust == 5:
            TypeText("\nTrust = 5\n" "Woah, your leadership skills are amazing! The people around you would jump of a cliff for you!")

    time.sleep(2)

    #Supplies
    if supplies == 1:
            TypeText ("\nSupplies = 1\n" "Your household is starving... Your health has decreased.")
            health = health - 1
            TypeText ("\nHealth now =", health)
    elif supplies == 2:
            TypeText ("\nSupplies = 2\n" "Your supplies are pretty low. If it gets any lower your family could starve..")
    elif supplies == 3:
            TypeText ("\nSupplies = 3\n" "Your supplies are okay, try to increase them soon.")
    elif supplies == 4:
            TypeText("\nSupplies = 4\n" "Your supplies are pretty good, let's keep it that way!")
